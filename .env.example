DATABASE_URL=postgresql://retro:retro@localhost:5432/retro
PORT=3000
ORIGIN=http://localhost:3000
# AES-256-GCM для карточек, комментариев и вебхуков Битрикс24: 64 hex-символа, сгенерировать — openssl rand -hex 32.
# Без ключа подключение Битрикс24 недоступно (панель пространства скажет «шифрование не настроено»)
ENCRYPTION_KEY=

# Upload
BODY_SIZE_LIMIT=20971520

# Docker port mapping (production)
APP_PORT=80

# Мониторинг
STATSD_HOST=localhost
STATSD_PORT=8125
LOG_LEVEL=info

# Netdata Cloud (опционально)
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=

# Telegram feedback notifications (опционально)
# 1. Создай бота через @BotFather, получи токен
# 2. Напиши боту /start
# 3. Получи chat_id: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TG_BOT_TOKEN=
TG_CHAT_ID=
# Если api.telegram.org недоступен с хостинга (РФ):
# TG_PROXY — SOCKS-прокси вне РФ, через который слать сообщения
# TG_API_BASE — либо HTTP-форвардер, подменяющий api.telegram.org
TG_PROXY=
TG_API_BASE=https://api.telegram.org

# AI-анализ пространства (опционально). Без ключа кнопка не показывается.
# Ключ выдаёт platform.deepseek.com; API совместим с OpenAI chat/completions.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com

# Битрикс24 (опционально)
# BITRIX_ALLOW_HTTP=1 — только для e2e: разрешает вебхук http://localhost:{port}/ мока портала; на проде не ставить
# BITRIX_IMAGE_MAX_BYTES=4194304 — картинка карточки крупнее (в байтах) к задаче не прикрепляется; по умолчанию 4 МБ
